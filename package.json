{
  "name": "vision-english",
  "version": "1.0.0",
  "private": true,
  "description": "Vision 1 English for Schools - Grade 10 English, Lessons 1 & 2, with word-level audio/text synchronization",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "sync": "cap sync android",
    "android:add": "cap add android",
    "android:open": "cap open android",
    "apk:build": "npm run build && npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
