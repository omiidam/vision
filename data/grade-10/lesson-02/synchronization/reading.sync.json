 "sentences": [
  {
   "first": 0,
   "last": 9,
   "start": 10.4,
   "end": 13.22,
   "text": "A Wonderful Liquid The human body is a real wonder."
  },
  {
   "first": 10,
   "last": 22,
   "start": 14.1,
   "end": 17.76,
   "text": "It is sometimes good to think about our body and how it works."
  },
  {
   "first": 23,
   "last": 32,
   "start": 18.56,
   "end": 21.28,
   "text": "Our body is doing millions of jobs all the time."
  },
  {
   "first": 33,
   "last": 43,
   "start": 22.36,
   "end": 25.0,
   "text": "One of the most important parts of the body is blood."
  },
  {
   "first": 44,
   "last": 52,
   "start": 25.96,
   "end": 28.48,
   "text": "The heart pumps this red liquid around the body."
  },
  {
   "first": 53,
   "last": 58,
   "start": 29.28,
   "end": 31.1,
   "text": "This keeps us healthy and alive."
  },
  {
   "first": 59,
   "last": 65,
   "start": 32.36,
   "end": 34.26,
   "text": "More than half of blood is plasma."
  },
  {
   "first": 66,
   "last": 72,
   "start": 35.02,
   "end": 36.84,
   "text": "This is a clear and yellow liquid."
  },
  {
   "first": 73,
   "last": 78,
   "start": 37.84,
   "end": 39.48,
   "text": "It carries red and white cells."
  },
  {
   "first": 79,
   "last": 91,
   "start": 40.54,
   "end": 44.2,
   "text": "There are millions of red blood cells in one small drop of blood."
  },
  {
   "first": 92,
   "last": 104,
   "start": 45.08,
   "end": 50.16,
   "text": "They carry oxygen round the body and collect carbon dioxide from body parts."
  },
  {
   "first": 105,
   "last": 115,
   "start": 50.98,
   "end": 53.62,
   "text": "There are thousands of white cells in a drop of blood."
  },
  {
   "first": 116,
   "last": 121,
   "start": 54.3,
   "end": 55.86,
   "text": "They are bigger than red cells."
  },
  {
   "first": 122,
   "last": 127,
   "start": 55.86,
   "end": 58.9,
   "text": "They defend our body against microbes."
  },
  {
   "first": 128,
   "last": 136,
   "start": 60.18,
   "end": 63.32,
   "text": "This wonderful liquid is a great gift from Allah."
  },
  {
   "first": 137,
   "last": 145,
   "start": 64.02,
   "end": 66.94,
   "text": "We can thank Allah by keeping our body healthy."
  },
  {
   "first": 146,
   "last": 158,
   "start": 68.12,
   "end": 72.54,
   "text": "One way to do that is eating healthy food and doing daily exercises."
  },
  {
   "first": 159,
   "last": 170,
   "start": 73.52,
   "end": 76.94,
   "text": "Another way is to donate our blood to those who need it."
  }
 ],
